<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <queries>
        <package android:name="com.openai.chatgpt" />
    </queries>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Jarvis Bridge"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/svg+xml" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="jarvisbridge" android:host="open" />
            </intent-filter>
        </activity>
        <service android:name=".JarvisBubbleService" android:exported="false" />
        <activity android:name=".EasySetVisionActivity" android:exported="false" />
        <!-- Transparent, isolated task for a one-time system capture permission.
             No Jarvis Bridge settings window is ever placed over xTool. -->
        <activity
            android:name=".EasySetConsentActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="ca.jarvis.bridge.easyset.consent"
            android:excludeFromRecents="true" />
        <service
            android:name=".EasySetCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".EasySetSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!-- Facultatif : l'utilisateur doit activer ce service dans Accessibilité. -->
        <service
            android:name=".ChatGptBubbleAccessibilityService"
            android:label="Jarvis Bridge — ouverture ChatGPT"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/chatgpt_bubble_accessibility" />
        </service>
        <!-- Service independant, active uniquement par l'utilisateur, un clic ponctuel sur l'onglet EasySet. -->
        <service
            android:name=".EasySetPanelClickService"
            android:label="Jarvis — test bouton EasySet"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/easyset_panel_click_accessibility" />
        </service>
        <service
            android:name=".JarvisNotificationListener"
            android:label="Jarvis Bridge — Gmail"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
